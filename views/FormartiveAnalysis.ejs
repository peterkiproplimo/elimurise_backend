<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Performance Analysis</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        font-family: 'Times New Roman', Times, serif;
        font-weight: 100;
        font-size: 7px;
        -webkit-print-color-adjust: exact;
        box-sizing: border-box;
      }

      .page {
        position: relative;
        display: block;
        background: white;
        page-break-after: auto;
        margin: 50px;
        overflow: hidden;
      }

      @media print {
        body {
          background: white;
        }

        .page {
          margin: 0;
          height: 100%;
          width: 100%;
        }
      }

      .page.first {
        border-left: 5px solid green;
      }

      .bottom {
        position: absolute;
        left: 5mm;
        right: 5mm;
        bottom: 5mm;
      }

      .group {
        margin-top: 3mm;
      }

      .line {
        color: white;
        position: relative;
      }

      .center {
        text-align: center;
      }

      .logo {
        position: relative;
        width: 80%;
        left: 10%;
        top: 15%;
      }

      table {
        font-family: 'Times New Roman', Times, serif;
        border-collapse: collapse;
        width: 100%;
      }

      td,
      th {
        text-align: left;
        vertical-align: baseline;
      }

      .result td,
      .result th {
        border: 1px solid black;
        text-align: left;
        padding: 8px;
        vertical-align: baseline;
      }

      .result tr:nth-child(even) {
        background-color: #f7f5f5;
      }

      .container {
        display: flex;
        flex-direction: column;
        text-align: center;
        justify-content: space-between;
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 20px;
      }

      .image-container {
        display: flex;
        align-items: center;
        margin-bottom: 16px;
      }

      table img {
        width: 58px;
        height: 58px;
        margin-bottom: 8px;
        border-radius: 5px;
        -webkit-box-reflect: below 0px linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.4));
        border: 1px solid blue;
      }

      .info {
        font-size: 10px;
      }

      .topic {
        margin-top: 8px;
      }

      .topic img {
        width: 256px;
        height: 96px;
        margin-bottom: 8px;
      }

      .double-line {
        border: 0;
        height: 0;
        position: relative;
        margin: 2px 0;
      }

      .double-line::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        border-top: 2px solid green;
      }

      .double-line::after {
        content: '';
        position: absolute;
        top: 3px;
        left: 0;
        width: 100%;
        border-top: 1px solid red;
      }

      .info {
        font-family: 'Times New Roman', Times, serif;
        line-height: 2.5;
        margin: 0;
      }

      .info .label {
        font-family: 'Times New Roman', Times, serif;
        text-transform: uppercase;
      }

      .info .value {
        text-decoration: underline;
        text-transform: uppercase;
        font-weight: bold;
      }

      .info div {
        margin-bottom: 0;
      }

      .letterhead {
        text-align: center;
        font-size: 15px;
        text-transform: uppercase;
        margin: 0;
      }

      .letterhead img {
        max-width: 100%;
        max-height: 70px;
        width: auto;
        height: auto;
        display: block;
        margin: 0 auto 10px;
      }

      .letterhead .school-name {
        font-weight: bold;
        text-transform: uppercase;
        font-size: 18px;
      }

      .letterhead .address {
        text-transform: uppercase;
        font-size: 8px;
      }

      td {
        position: relative;
      }

      td::after {
        content: '';
        position: absolute;
        right: -1px;
        top: 0;
        height: 100%;
        width: 1px;
        background-color: #000;
      }

      tr {
        page-break-inside: avoid;
      }

      td {
        page-break-inside: avoid;
      }
      @media print {
        tr {
          page-break-inside: avoid; /* Prevent page break inside a row */
        }
      }
    </style>
  </head>
  <body>
    <div class="letterhead">
      <img src="<%= logoDataUrl %>" alt="School Logo" />
      <div class="school-name"><%= school.name %></div>
      <div class="school-name">Performance Analysis</div>
      <div class="info">
        <% if (header && header.stream) { %>
        <span class="label">STREAM:</span> <span class="value"><%= header.stream %></span>
        <% } else { %>
        <span class="label">STREAM:</span> <span class="value">overall</span>
        <% } %> <% if (header && header.grade) { %>
        <span class="label">GRADE:</span> <span class="value"><%= header.grade %></span>

        <% } %>
      </div>
      <div class="info">
        <span> Learning Area : <%= learningArea.name %></span>
      </div>
      <div class="address">
        <i><%= school.address %></i>
      </div>
    </div>
    <div class="double-line"></div>
    <div class=""></div>
    <img src="<%= elimuriselogoDataUrl %>" style="display: none" alt="Learner" />
    <!-- <table border="1" class="result" cellpadding="10">
        <thead>
            <tr>
                <th>Strand</th>
                <th>Substrand</th>
                <th>Indicator</th>
                <th>Performance Description</th>
                <th>Count</th>
            </tr>
        </thead>
        <tbody> -->
    <table border="1" class="result" cellpadding="10">
      <thead>
        <tr>
          <th>Strand</th>
          <th>Substrand</th>
          <th>Indicator</th>
          <th>Exceeding Expectation (EE)</th>
          <th>Meeting Expectation (ME)</th>
          <th>Approaching Expectation (AE)</th>
          <th>Below Expectation (BE)</th>
        </tr>
      </thead>
      <tbody>
        <% let previousStrand = ''; %> <% let previousSubstrand = ''; %> <% data.forEach(strandItem => { %> <%
        strandItem.substrands.forEach(substrandItem => { %> <% substrandItem.indicators.forEach((indicator, index) => {
        %>
        <tr>
          <% if (previousStrand !== strandItem._id) { %>
          <td rowspan="<%= substrandItem.length %>"><%- strandItem._id.replace(/\n/g, ' ').trim() %></td>
          <% previousStrand = strandItem._id; %> <% } else { %>
          <td></td>
          <% } %> <% if (previousSubstrand !== substrandItem.substrand) { %>
          <td rowspan="<%= substrandItem.length %>"><%- substrandItem.substrand %></td>
          <% previousSubstrand = substrandItem.substrand; %> <% } else { %>
          <td></td>
          <% } %>

          <td><%- indicator.name %></td>
          <td><%= indicator.performanceCounts.exceedingExpectation.count %></td>
          <td><%= indicator.performanceCounts.meetingExpectation.count %></td>
          <td><%= indicator.performanceCounts.approachingExpectation.count %></td>
          <td><%= indicator.performanceCounts.belowExpectation.count %></td>
        </tr>
        <% }) %> <% }) %> <% }) %>
      </tbody>
    </table>

    <!-- </table> -->
  </body>
</html>
